<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Solus.Telemetry.Consumer.Apr</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Solus.Telemetry.Contracts" Version="[$(TelemetryVersion)]" />
    <PackageReference Include="SolusAgent.Telemetry" Version="[$(TelemetryVersion)]" />
    <PackageReference Include="SolusAgent.Api" Version="[$(AgentApiVersion)]" />
  </ItemGroup>
</Project>
