<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>PackageConsumers.LiveSmoke</AssemblyName>
    <SolusAgentVersion Condition="'$(SolusAgentVersion)' == ''">0.1.0-internal.1</SolusAgentVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SolusAgent.Api" Version="[$(SolusAgentVersion)]" />
    <PackageReference Include="SolusAgent.Tools.Api" Version="[$(SolusAgentVersion)]" />
    <PackageReference Include="SolusAgent.Runtime.Api" Version="[$(SolusAgentVersion)]" />
    <PackageReference Include="SolusAgent.Runtime" Version="[$(SolusAgentVersion)]" />
    <PackageReference Include="SolusAgent.Providers.DeepSeek" Version="[$(SolusAgentVersion)]" />
  </ItemGroup>
</Project>
